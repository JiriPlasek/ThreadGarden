{
  "name": "@threadgarden/service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:real": "vitest run --config vitest.real.config.ts",
    "dev": "tsx src/bin.ts",
    "mock": "tsx src/testing/mock-main.ts",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.314",
    "@threadgarden/protocol": "workspace:*",
    "fdir": "^6.5.0",
    "fuzzysort": "^4.0.2",
    "ignore": "^7.0.14",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6"
  }
}
