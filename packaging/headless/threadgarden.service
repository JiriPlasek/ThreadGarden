[Unit]
Description=Threadgarden headless service
After=network-online.target

[Service]
ExecStart=%h/.local/share/threadgarden-headless/current/bin/threadgarden serve --headless
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
