#!/bin/sh
# Launcher: runs the bundled Node on the bundled service, whatever the cwd and
# however this file was reached (a symlink in ~/.local/bin, say).
set -eu
self=$0
while [ -L "$self" ]; do
  dir=$(CDPATH= cd -- "$(dirname "$self")" && pwd)
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$dir/$target ;;
  esac
done
here=$(CDPATH= cd -- "$(dirname "$self")" && pwd)
exec "$here/node" --disable-warning=ExperimentalWarning "$here/../lib/service.mjs" "$@"
