{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Threadgarden",
  "version": "0.3.1",
  "identifier": "dev.threadgarden.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --filter @threadgarden/service build && pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Threadgarden",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2ODhGQTdCNTY1MTk4OTEKUldTUm1GRldlL3FJQml6M3FES25XZUZKREtkVzlSZVYrbytJalhabEQ1WVpwSUh1bFlOQTNhaEsK",
      "endpoints": [
        "https://github.com/JiriPlasek/ThreadGarden/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
