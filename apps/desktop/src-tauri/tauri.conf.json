{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pahub",
  "version": "0.1.0",
  "identifier": "dev.pahub.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm --filter @pahub/service build && pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pahub",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
