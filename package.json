{
  "name": "pahub-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r lint && eslint scripts",
    "format": "prettier --write . && pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:perf",
    "test:perf": "pnpm -r --workspace-concurrency=1 test:perf",
    "test:e2e": "pnpm --filter desktop test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
